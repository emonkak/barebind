engine biome(1.0)
language js

or {
  or {
    `const $const_name = createComponent(function $fn_name($_) { $_ }, $...)`,
    `const $const_name = createComponent<$...>(function $fn_name($_) { $_ }, $...)`
  } where {
    not $fn_name <: $const_name,
    $fn_name => $const_name,
    register_diagnostic(span=$fn_name, message="Component function name must match the assigned const variable name.", severity="warn")
  },
  or {
    `createComponent(function($_) { $_ }, $...)`,
    `createComponent<$...>(function($_) { $_ }, $...)`
  } as $call where {
    register_diagnostic(span=$call, message="createComponent() must take a named function expression, anonymous functions are not allowed.", severity="warn")
  },
  or {
    `createComponent(($_) => $_, $...)`,
    `createComponent<$...>(($_) => $_, $...)`
  } as $call where {
    register_diagnostic(span=$call, message="createComponent() must take a named function expression, arrow functions are not allowed.", severity="warn")
  }
}
