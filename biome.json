{
  "files": {
    "includes": ["**", "!coverage", "!examples/*/lib", "!lib", "!tools/*/lib"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "noUnusedLabels": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConfusingLabels": "off",
        "noConfusingVoidType": "off",
        "noConstEnum": "off",
        "noEmptyInterface": "off",
        "noExplicitAny": "off",
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "document": "global document is not allowed.",
                  "location": "global location is not allowed.",
                  "navigation": "global navigation is not allowed."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ],
  "plugins": ["biome/use-named-component.grit"]
}
